rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow updating completedSales and totalEarned if user is a seller in a transaction
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedSales', 'totalEarned']))
      );
    }

    // Wishlists collection
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Items subcollection within a user's wishlist
      match /items/{wishlistItemId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Listings collection
    match /listings/{listing} {
      // Anyone can read listings
      allow read: if true;
      
      // Only authenticated users can create listings
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid;
      
      // Only the owner can update or delete their listings
      allow update, delete: if request.auth != null && 
                               resource.data.userId == request.auth.uid;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Users can read chats they are part of
      // Allow read if user is in participants (for existing chats) OR if chatId contains their userId (for new chats)
      allow read: if request.auth != null && 
                     (request.auth.uid in resource.data.participants ||
                      chatId.matches('.*' + request.auth.uid + '.*'));
      
      // Users can create chats if they are one of the participants
      allow create: if request.auth != null && 
                       request.auth.uid in request.resource.data.participants;
      
      // Users can update chats they are part of
      allow update: if request.auth != null && 
                       (request.auth.uid in resource.data.participants ||
                        chatId.matches('.*' + request.auth.uid + '.*'));
      
      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages in chats they are part of
        allow read: if request.auth != null && 
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Users can create messages in chats they are part of
        allow create: if request.auth != null && 
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid;
        
        // Users can update/delete their own messages
        allow update, delete: if request.auth != null && 
                                 resource.data.senderId == request.auth.uid;
      }
    }

    // Scavenger Hunt Items collection
    match /scavenger_hunt_items/{itemId} {
      // Authenticated users can read all scavenger hunt items (global view)
      allow read: if request.auth != null;
      
      // Only authenticated users can create scavenger hunt items
      // Must include userId matching the creator
      // Validates required fields
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'title', 'price', 'description', 'imageUrl', 
                                                            'latitude', 'longitude', 'quantity', 'isActive', 'createdAt', 'status']) &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.price is number &&
                       request.resource.data.price >= 0 &&
                       request.resource.data.quantity is int &&
                       request.resource.data.quantity > 0 &&
                       request.resource.data.isActive is bool &&
                       request.resource.data.latitude is number &&
                       request.resource.data.longitude is number &&
                       request.resource.data.status in ['available', 'taken', 'ended'];
      
      // Users can update items:
      // 1. Only the creator (userId matches) can toggle isActive status or delete
      // 2. Only the creator can update status field ('available', 'taken', 'ended')
      // 3. Only the creator can update other item details (title, description, price, etc.)
      allow update: if request.auth != null && 
                       resource.data.userId == request.auth.uid && (
                         // Toggling active/inactive status
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']) ||
                         
                         // Updating item status (available, taken, ended)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                          request.resource.data.status in ['available', 'taken', 'ended']) ||
                         
                         // Updating item details
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'price', 'quantity', 'eventEndTime']) ||
                         
                         // Updating claimed status (for backward compatibility)
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedBy', 'claimedAt'])
                       );
      
      // Only the creator (userId matches) can delete their own scavenger hunt items
      allow delete: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read transactions where they are buyer or seller
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.buyerId || 
                      request.auth.uid == resource.data.sellerId);
      
      // Users can create transactions if they are the buyer
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.buyerId;
      
      // Users can update transactions if they are buyer or seller
      allow update: if request.auth != null && 
                       (request.auth.uid == resource.data.buyerId || 
                        request.auth.uid == resource.data.sellerId);
      
      // Only buyer can delete their transaction
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.buyerId;
    }
  }
}
